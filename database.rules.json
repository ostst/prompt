{
  "rules": {
    "meta": {
      ".read": false,
      ".write": false
    },
    "messages": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "typing": {
      ".read": true,
      ".write": true
    },
    "members": {
      ".read": true,
      ".write": true
    }
  }
}
